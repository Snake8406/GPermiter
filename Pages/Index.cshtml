@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="py-4">
    <h1 class="display-5">Gallagher Permitter Portal</h1>
    <p class="lead">Role-based login foundation for Gallagher Command Centre REST API integration.</p>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <p>You are signed in as <strong>@User.Identity.Name</strong>.</p>
        <ul>
            <li><a asp-page="/EndUser/Dashboard">Open End User Dashboard</a></li>
            @if (User.IsInRole("User") || User.IsInRole("Admin"))
            {
                <li><a asp-page="/User/Dashboard">Open User Dashboard</a></li>
            }
            @if (User.IsInRole("Admin"))
            {
                <li><a asp-page="/Admin/Users">Manage users</a></li>
            }
        </ul>
    }
    else
    {
        <p>New customers can register freely as end users.</p>
        <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Register">Register as End User</a>
    }
</div>
